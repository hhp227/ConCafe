rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN";
    }

    function isCafeOwner(cafeId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/cafes/$(cafeId)).data.ownerIds;
    }

    function isCafeOwnerEditableUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        "name",
        "desc",
        "thumbnailImage",
        "galleryImages",
        "businessHours",
        "phoneNumber",
        "region"
      ]);
    }

    function canManageCafe(cafeId) {
      return isAdmin() || isCafeOwner(cafeId);
    }

    function isValidScheduleStatus(status) {
      return status == "WORK" || status == "OFF" || status == "VACATION";
    }

    function isValidCastScheduleWriteData() {
      return request.resource.data.cafeId is string
        && request.resource.data.castId is string
        && request.resource.data.date is string
        && request.resource.data.status is string
        && isValidScheduleStatus(request.resource.data.status)
        && (
          (
            request.resource.data.status == "WORK"
            && request.resource.data.startTime is string
            && request.resource.data.endTime is string
          )
          ||
          request.resource.data.status != "WORK"
        );
    }

    match /homeBanners/{bannerId} {
      allow read: if true;
      allow write: if false;
    }

    match /cafes/{cafeId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isCafeOwner(cafeId) && isCafeOwnerEditableUpdate());

      match /casts/{castId} {
        allow read: if true;
        allow write: if canManageCafe(cafeId);
      }

      match /notices/{noticeId} {
        allow read: if true;
        allow write: if canManageCafe(cafeId);
      }

      match /events/{eventId} {
        allow read: if true;
        allow write: if canManageCafe(cafeId);
      }

      match /menus/{menuId} {
        allow read: if true;
        allow write: if canManageCafe(cafeId);
      }

      match /goods/{goodsId} {
        allow read: if true;
        allow write: if canManageCafe(cafeId);
      }
    }

    match /visits/{visitId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isSelf(userId) || isAdmin());
      allow create: if isSelf(userId);
      allow update: if isSelf(userId) || isAdmin();
      allow delete: if isSelf(userId);
    }

    match /cafeRegistrationClaims/{claimId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /cafeOwnerClaims/{claimId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /castSchedules/{scheduleId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && isValidCastScheduleWriteData()
        && canManageCafe(request.resource.data.cafeId)
        && exists(
          /databases/$(database)/documents/cafes/$(request.resource.data.cafeId)/casts/$(request.resource.data.castId)
        );
      allow delete: if isSignedIn()
        && resource.data.cafeId is string
        && resource.data.castId is string
        && canManageCafe(resource.data.cafeId)
        && exists(
          /databases/$(database)/documents/cafes/$(resource.data.cafeId)/casts/$(resource.data.castId)
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
