rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN";
    }

    function isCafeOwner(cafeId) {
      return isSignedIn()
        && ("ownerIds" in resource.data)
        && request.auth.uid in resource.data.ownerIds;
    }

    function isCafeOwnerEditableUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        "name",
        "desc",
        "thumbnailImage",
        "galleryImages",
        "businessHours",
        "phoneNumber",
        "region"
      ]);
    }

    match /homeBanners/{bannerId} {
      allow read: if true;
      allow write: if false;
    }

    match /cafes/{cafeId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isCafeOwner(cafeId) && isCafeOwnerEditableUpdate());

      match /casts/{castId} {
        allow read: if true;
        allow write: if false;
      }

      match /notices/{noticeId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /visits/{visitId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isSelf(userId) || isAdmin());
      allow create: if isSelf(userId);
      allow update: if isSelf(userId) || isAdmin();
      allow delete: if isSelf(userId);
    }

    match /cafeRegistrationClaims/{claimId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /cafeOwnerClaims/{claimId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
